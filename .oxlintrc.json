{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["react", "typescript", "oxc", "unicorn"],
    "env": {
        "browser": true
    },
    "categories": {
        "correctness": "error"
    },
    "rules": {
        "react/react-in-jsx-scope": "off",
        "react-hooks/exhaustive-deps": "warn",
        "react/set-state-in-effect": "warn"
    },
    "ignorePatterns": ["dist"]
}
